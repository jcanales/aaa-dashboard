# Airbyte version to install
AIRBYTE_VERSION=0.63.11

# Port to expose Airbyte UI
AIRBYTE_PORT=8000

# ----------------------------------------------------------
# MS SQL Server Source (fill with real values)
# ----------------------------------------------------------
MSSQL_HOST=your-mssql-host
MSSQL_PORT=1433
MSSQL_DATABASE=your_database_name
MSSQL_USERNAME=your_username
MSSQL_PASSWORD=your_password

# ----------------------------------------------------------
# PostgreSQL Destination (duties-dashboard DB)
# These match the main docker-compose.yml defaults
# ----------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jd_tariff_monitor
POSTGRES_USER=jduser
POSTGRES_PASSWORD=JdTariff2024

# ─────────────────────────────────────────────
# Duties Dashboard — server environment layout
# Copy to .env and fill in real values
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── PostgreSQL (internal — managed by Docker) ─
# Overridden by docker-compose.yml; set here for local dev only
DATABASE_URL=postgresql://jduser:JdTariff2024@localhost:5432/jd_tariff_monitor
DB_PASSWORD=JdTariff2024

# ── Auth ─────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string

# ── Anthropic / Claude SDK ───────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Email (SMTP) ─────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@jdgroup.net
SMTP_PASS=

# ── Slack ────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── Frontend portal URL ───────────────────────
PORTAL_URL=https://tradeportal.jdgroup.net

# ── MS SQL Server — RB Systems source DB ─────
# Database: db_2506BIM  |  Server: ub.jdgroup.net
# Used for ETL / data sync from the legacy customs platform
MSSQL_HOST=ub.jdgroup.net
MSSQL_PORT=1433
MSSQL_DATABASE=db_2506BIM
MSSQL_USER=
MSSQL_PASSWORD=
# Set to true if the server uses a self-signed certificate (dev/on-prem)
MSSQL_TRUST_SERVER_CERT=true
# Set to true for Azure SQL or TLS-enforced instances
MSSQL_ENCRYPT=false
